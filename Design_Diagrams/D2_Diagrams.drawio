<mxfile host="app.diagrams.net"><diagram name="F1: D2 data extensions"><mxGraphModel page="1" pageWidth="1000" pageHeight="1040"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Local Study Assistant - F1: D2 data extensions" vertex="1" parent="1" style="text;html=0;fontSize=20;fontStyle=1;align=left;"><mxGeometry as="geometry" x="20" y="5" width="960" height="35" /></mxCell><mxCell id="goal" value="Goal: Help students keep notes and make study materials on their own computer for free." vertex="1" parent="1" style="text;html=0;fontSize=15;align=left;"><mxGeometry as="geometry" x="20" y="40" width="960" height="28" /></mxCell><mxCell id="legend" value="Boxes = entities; solid lines = relationships. PK = primary key; FK = foreign key.&#10;End counts describe each side: 1 = exactly one; 0..1 = optional one; 0..* = zero or more.&#10;D1 entities are shown for context; details and cross-course checks are in section 2.2." vertex="1" parent="1" style="text;html=0;fontSize=14;align=left;whiteSpace=wrap;"><mxGeometry as="geometry" x="20" y="65" width="960" height="75" /></mxCell><mxCell id="course" value="Course (D1)&#10;PK id&#10;name; timeZone" vertex="1" parent="1" style="rounded=0;html=0;whiteSpace=wrap;align=left;spacing=10;fontSize=15;fillColor=#f5f8fa;strokeColor=#18334d;"><mxGeometry as="geometry" x="20" y="155" width="250" height="90" /></mxCell><mxCell id="rule" value="ScheduleRule&#10;PK id; FK courseId&#10;weekday; localStart/End&#10;startDate/endDate; zone" vertex="1" parent="1" style="rounded=0;html=0;whiteSpace=wrap;align=left;spacing=10;fontSize=15;fillColor=#f5f8fa;strokeColor=#18334d;"><mxGeometry as="geometry" x="370" y="155" width="270" height="110" /></mxCell><mxCell id="session" value="ClassSession (D1+)&#10;PK id; FK courseId&#10;FK ruleId (optional)&#10;startsAt; endsAt" vertex="1" parent="1" style="rounded=0;html=0;whiteSpace=wrap;align=left;spacing=10;fontSize=15;fillColor=#f5f8fa;strokeColor=#18334d;"><mxGeometry as="geometry" x="750" y="155" width="230" height="110" /></mxCell><mxCell id="source" value="Source (D1+)&#10;PK id; FK courseId&#10;managedFileId&#10;storageState" vertex="1" parent="1" style="rounded=0;html=0;whiteSpace=wrap;align=left;spacing=10;fontSize=15;fillColor=#f5f8fa;strokeColor=#18334d;"><mxGeometry as="geometry" x="20" y="330" width="220" height="100" /></mxCell><mxCell id="sugg" value="Suggestion&#10;PK id; FK baseSourceId&#10;FK jobId; state&#10;acceptedSourceId" vertex="1" parent="1" style="rounded=0;html=0;whiteSpace=wrap;align=left;spacing=10;fontSize=15;fillColor=#f5f8fa;strokeColor=#18334d;"><mxGeometry as="geometry" x="300" y="330" width="220" height="100" /></mxCell><mxCell id="evidence" value="SuggestionEvidence&#10;PK FK suggestionId&#10;+ FK passageId&#10;+ quoteStart/End" vertex="1" parent="1" style="rounded=0;html=0;whiteSpace=wrap;align=left;spacing=10;fontSize=15;fillColor=#f5f8fa;strokeColor=#18334d;"><mxGeometry as="geometry" x="590" y="330" width="200" height="100" /></mxCell><mxCell id="passage" value="Passage (D1)&#10;PK id&#10;FK sourceId&#10;text; location" vertex="1" parent="1" style="rounded=0;html=0;whiteSpace=wrap;align=left;spacing=10;fontSize=15;fillColor=#f5f8fa;strokeColor=#18334d;"><mxGeometry as="geometry" x="850" y="330" width="130" height="100" /></mxCell><mxCell id="item" value="StudyItem (D1)&#10;PK id; FK jobId&#10;status; references&#10;accepted before use" vertex="1" parent="1" style="rounded=0;html=0;whiteSpace=wrap;align=left;spacing=10;fontSize=15;fillColor=#f5f8fa;strokeColor=#18334d;"><mxGeometry as="geometry" x="20" y="520" width="220" height="105" /></mxCell><mxCell id="reviewstate" value="ReviewState&#10;PK FK itemId; version&#10;dueAt; intervalDays" vertex="1" parent="1" style="rounded=0;html=0;whiteSpace=wrap;align=left;spacing=10;fontSize=15;fillColor=#f5f8fa;strokeColor=#18334d;"><mxGeometry as="geometry" x="330" y="480" width="280" height="80" /></mxCell><mxCell id="event" value="ReviewEvent&#10;PK eventId; F