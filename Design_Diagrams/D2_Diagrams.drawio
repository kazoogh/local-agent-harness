lue="Extract in bounded worker&#10;Keep page/slide locations&#10;Enforce time/text/expanded-byte caps" vertex="1" parent="1" style="rounded=1;html=0;whiteSpace=wrap;align=left;spacing=10;fontSize=15;fillColor=#f5f8fa;strokeColor=#18334d;"><mxGeometry as="geometry" x="50" y="290" width="390" height="85" /></mxCell><mxCell id="failed" value="Stop; no partial publication&#10;PARSE_FAILED / IMPORT_LIMIT&#10;TIMEOUT / NO_TEXT" vertex="1" parent="1" style="rounded=1;html=0;whiteSpace=wrap;align=left;spacing=10;fontSize=15;fillColor=#fff1f1;strokeColor=#18334d;"><mxGeometry as="geometry" x="610" y="290" width="340" height="85" /></mxCell><mxCell id="commit" value="Publish ready source transaction&#10;Recheck ownership / stage identity&#10;File + DB recovery reconciles crashes" vertex="1" parent="1" style="rounded=1;html=0;whiteSpace=wrap;align=left;spacing=10;fontSize=15;fillColor=#f5f8fa;strokeColor=#18334d;"><mxGeometry as="geometry" x="50" y="450" width="390" height="90" /></mxCell><mxCell id="storagefail" value="Rollback / reconcile staging&#10;STORAGE_ERROR / DISK_FULL&#10;Keep independent notes" vertex="1" parent="1" style="rounded=1;html=0;whiteSpace=wrap;align=left;spacing=10;fontSize=15;fillColor=#fff1f1;strokeColor=#18334d;"><mxGeometry as="geometry" x="610" y="450" width="340" height="90" /></mxCell><mxCell id="index" value="Import committed; queue indexing&#10;Saved source visible now&#10;Search waits for index readiness" vertex="1" parent="1" style="rounded=1;html=0;whiteSpace=wrap;align=left;spacing=10;fontSize=15;fillColor=#f5f8fa;strokeColor=#18334d;"><mxGeometry as="geometry" x="50" y="620" width="390" height="95" /></mxCell><mxCell id="degrade" value="Import stays committed&#10;MODEL_UNAVAILABLE / BUSY&#10;Retry indexing after correction" vertex="1" parent="1" style="rounded=1;html=0;whiteSpace=wrap;align=left;spacing=10;fontSize=15;fillColor=#fff1f1;strokeColor=#18334d;"><mxGeometry as="geometry" x="610" y="620" width="340" height="95" /></mxCell><mxCell id="e0" value="invalid" edge="1" parent="1" style="endArrow=classic;strokeColor=#b33b3b;fontSize=14;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="440" y="180" /><mxPoint as="targetPoint" x="610" y="180" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e1" value="valid" edge="1" parent="1" style="endArrow=classic;strokeColor=#18334d;fontSize=14;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="245" y="220" /><mxPoint as="targetPoint" x="245" y="290" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e2" value="failure / zero text" edge="1" parent="1" style="endArrow=classic;strokeColor=#b33b3b;fontSize=14;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="440" y="330" /><mxPoint as="targetPoint" x="610" y="330" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e3" value="readable" edge="1" parent="1" style="endArrow=classic;strokeColor=#18334d;fontSize=14;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="245" y="375" /><mxPoint as="targetPoint" x="245" y="450" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e4" value="failed commit" edge="1" parent="1" style="endArrow=classic;strokeColor=#b33b3b;fontSize=14;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="440" y="490" /><mxPoint as="targetPoint" x="610" y="490" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e5" value="success" edge="1" parent="1" style="endArrow=classic;strokeColor=#18334d;fontSize=14;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="245" y="540" /><mxPoint as="targetPoint" x="245" y="620" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e6" value="index unavailable" edge="1" parent="1" style="endArrow=classic;strokeColor=#b33b3b;fontSize=14;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="440" y="660" /><mxPoint as="targetPoint" x="610" y="660" /><Array as="points" /></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="F3: Background job lifecycle"><mxGraphModel page="1" pageWidth="1000" pageHeight="800"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Local Study Assistant - F3: Background job lifecycle" vertex="1" parent="1" style="text;html=0;fontSize=20;fontStyle=1;align=left;"><mxGeometry as="geometry" x="20" y="5" width="960" height="35" /></mxCell><mxCell id="goal" value="Goal: Help students keep notes and make study materials on their own computer for free." vertex="1" parent="1" style="text;html=0;fontSize=15;align=left;"><mxGeometry as="geometry" x="20" y="40" width="960" height="28" /></mxCell><mxCell id="legend" value="Boxes = persistent StudyJob states. Arrows = allowed transitions with trigger labels.&#10;Red arrows = failure transitions. Terminal states never resume; Retry creates a new job ID.&#10;Each publication checks library/settings revisions and cancellation in its final transaction." vertex="1" parent="1" style="text;html=0;fontSize=14;align=left;whiteSpace=wrap;"><mxGeometry as="geometry" x="20" y="65" width="960" height="75" /></mxCell><mxCell id="queued" value="queued&#10;requestKey unique&#10;Queue admission transaction" vertex="1" parent="1" style="rounded=1;html=0;whiteSpace=wrap;align=left;spacing=10;fontSize=15;fillColor=#f5f8fa;strokeColor=#18334d;"><mxGeometry as="geometry" x="80" y="180" width="330" height="100" /></mxCell><mxCell id="running" value="running&#10;One global model worker&#10;No open DB inference transaction" vertex="1" parent="1" style="rounded=1;html=0;whiteSpace=wrap;align=left;spacing=10;fontSize=15;fillColor=#f5f8fa;strokeColor=#18334d;"><mxGeometry as="geometry" x="590" y="180" width="330" height="100" /></mxCell><mxCell id="done" value="done&#10;Validated drafts + citations&#10;Atomic final publication&#10;Read-only terminal outcome" vertex="1" parent="1" style="rounded=1;html=0;whiteSpace=wrap;align=left;spacing=10;fontSize=15;fillColor=#f5f8fa;strokeColor=#18334d;"><mxGeometry as="geometry" x="590" y="480" width="330" height="110" /></mxCell><mxCell id="failed" value="failed&#10;CANCELLED / INTERRUPTED&#10;TIMEOUT / MODEL_UNAVAILABLE&#10;STALE_LIBRARY / SETTINGS_CHANGED&#10;NO_SUPPORTED_ITEMS / storage error&#10;Correct cause; submit a new job" vertex="1" parent="1" style="rounded=1;html=0;whiteSpace=wrap;align=left;spacing=10;fontSize=15;fillColor=#fff1f1;strokeColor=#18334d;"><mxGeometry as="geometry" x="80" y="480" width="330" height="155" /></mxCell><mxCell id="e0" value="worker claims" edge="1" parent="1" style="endArrow=classic;strokeColor=#18334d;fontSize=14;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="410" y="230" /><mxPoint as="targetPoint" x="590" y="230" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e1" value="valid + current + not cancelled" edge="1" parent="1" style="endArrow=classic;strokeColor=#18334d;fontSize=14;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="755" y="280" /><mxPoint as="targetPoint" x="755" y="480" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e2" value="cancel / restart" edge="1" parent="1" style="endArrow=classic;strokeColor=#b33b3b;fontSize=14;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="245" y="280" /><mxPoint as="targetPoint" x="245" y="480" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e3" value="error / cancel / stale" edge="1" parent="1" style="endArrow=classic;strokeColor=#b33b3b;fontSize=14;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="590" y="260" /><mxPoint as="targetPoint" x="410" y="550" /><Array as="points"><mxPoint x="500" y="260" /><mxPoint x="500" y="550" /></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>